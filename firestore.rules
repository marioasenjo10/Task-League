rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── App configuration (maintenance mode, etc.) ─────────────────────────
    // Public read so the maintenance screen can be shown even before login.
    // No client writes — an administrator edits `config/app` in the Firebase
    // console.
    match /config/{docId} {
      allow read:  if true;
      allow write: if false;
    }

    // ── Users ──────────────────────────────────────────────────────────────
    // Any authenticated user can READ any user profile (Members screen, Arena).
    // Owner can write everything on their own document.
    // Any authenticated user can update only HP/attack fields on another user's
    // document (needed for damage dealt by completing tasks).
    match /users/{userId} {
      allow read: if request.auth != null;

      // Full write only for the owner
      allow create, delete: if request.auth != null && request.auth.uid == userId;

      allow update: if request.auth != null && (
        // Owner can update any field on their own document
        request.auth.uid == userId
        ||
        // Other authenticated users can only touch per-league HP fields (damage)
        // and the attacker's daily-attack counters.
        // affectedKeys() returns top-level keys even when using dot notation.
        request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'hpByLeague',
              'lastHpResetByLeague',
              'todayAttacks',
              'lastAttackDate',
              'coins',
              'todayCoins',
              'lastCoinDate'
            ])
      );
    }

    // ── Leagues ────────────────────────────────────────────────────────────
    // Any authenticated user can read leagues (needed for join-by-code query).
    // Members can update; a non-member may only add themselves via invite code.
    // Only the owner can delete.
    match /leagues/{leagueId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && (
                      request.auth.uid in resource.data.memberIds
                      || (
                        request.auth.uid in request.resource.data.memberIds
                        && !(request.auth.uid in resource.data.memberIds)
                        && request.resource.data.memberIds.hasAll(
                          resource.data.memberIds
                        )
                        && request.resource.data.memberIds.size()
                            == resource.data.memberIds.size() + 1
                        && request.resource.data.diff(resource.data)
                            .affectedKeys()
                            .hasOnly(['memberIds'])
                      )
                    );
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerId;
    }

    // ── Tasks ──────────────────────────────────────────────────────────────
    // Only league members can read/write tasks.
    match /leagues/{leagueId}/tasks/{taskId} {
      allow read, write: if request.auth != null
                         && request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.memberIds;
    }

    // ── Task events (history) ──────────────────────────────────────────────
    match /leagues/{leagueId}/events/{eventId} {
      allow read, write: if request.auth != null
                         && request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.memberIds;
    }
  }
}
