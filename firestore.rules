rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isLeagueMember(leagueId) {
      return signedIn()
             && request.auth.uid in get(
               /databases/$(database)/documents/leagues/$(leagueId)
             ).data.memberIds;
    }

    function validUserKeys() {
      return request.resource.data.keys().hasOnly([
               'name',
               'email',
               'avatarUrl',
               'characterSkin',
               'calendarSync',
               'coins',
               'todayCoins',
               'lastCoinDate',
               'todayRewardedAds',
               'lastRewardedDate',
               'hpByLeague',
               'lastHpResetByLeague',
               'todayAttacks',
               'lastAttackDate',
               'bonusAttacksToday',
               'lastBonusAttackDate',
               'unlockedSkins',
               'shieldByLeague'
             ]);
    }

    function validNewUser() {
      return validUserKeys()
             && request.resource.data.keys().hasAll([
               'name', 'email', 'avatarUrl', 'characterSkin', 'calendarSync',
               'coins', 'todayCoins', 'lastCoinDate', 'todayRewardedAds',
               'lastRewardedDate', 'hpByLeague', 'lastHpResetByLeague',
               'todayAttacks', 'lastAttackDate', 'bonusAttacksToday',
               'lastBonusAttackDate', 'unlockedSkins', 'shieldByLeague'
             ])
             && request.resource.data.name is string
             && request.resource.data.email is string
             && request.resource.data.avatarUrl is string
             && request.resource.data.characterSkin is string
             && request.resource.data.calendarSync is bool
             && request.resource.data.coins is int
             && request.resource.data.coins >= 0
             && request.resource.data.todayCoins is int
             && request.resource.data.todayCoins >= 0
             && request.resource.data.todayCoins <= 5
             && request.resource.data.lastCoinDate is string
             && request.resource.data.todayRewardedAds is int
             && request.resource.data.todayRewardedAds >= 0
             && request.resource.data.todayRewardedAds <= 3
             && request.resource.data.lastRewardedDate is string
             && request.resource.data.hpByLeague is map
             && request.resource.data.lastHpResetByLeague is map
             && request.resource.data.todayAttacks is int
             && request.resource.data.todayAttacks >= 0
             && request.resource.data.todayAttacks <= 5
             && request.resource.data.lastAttackDate is string
             && request.resource.data.bonusAttacksToday is int
             && request.resource.data.bonusAttacksToday >= 0
             && request.resource.data.bonusAttacksToday <= 1
             && request.resource.data.lastBonusAttackDate is string
             && request.resource.data.unlockedSkins is list
             && request.resource.data.shieldByLeague is map;
    }

        function validUserUpdate() {
          let changed = request.resource.data.diff(resource.data).affectedKeys();
          return validUserKeys()
             && (!changed.hasAny(['name'])
               || request.resource.data.name is string)
             && (!changed.hasAny(['email'])
               || request.resource.data.email is string)
             && (!changed.hasAny(['avatarUrl'])
               || request.resource.data.avatarUrl is string)
             && (!changed.hasAny(['characterSkin'])
               || request.resource.data.characterSkin is string)
             && (!changed.hasAny(['calendarSync'])
               || request.resource.data.calendarSync is bool)
             && (!changed.hasAny(['coins'])
               || (request.resource.data.coins is int
                 && request.resource.data.coins >= 0))
             && (!changed.hasAny(['todayCoins'])
               || (request.resource.data.todayCoins is int
                 && request.resource.data.todayCoins >= 0
                 && request.resource.data.todayCoins <= 5))
             && (!changed.hasAny(['lastCoinDate'])
               || request.resource.data.lastCoinDate is string)
             && (!changed.hasAny(['todayRewardedAds'])
               || (request.resource.data.todayRewardedAds is int
                 && request.resource.data.todayRewardedAds >= 0
                 && request.resource.data.todayRewardedAds <= 3))
             && (!changed.hasAny(['lastRewardedDate'])
               || request.resource.data.lastRewardedDate is string)
             && (!changed.hasAny(['hpByLeague'])
               || request.resource.data.hpByLeague is map)
             && (!changed.hasAny(['lastHpResetByLeague'])
               || request.resource.data.lastHpResetByLeague is map)
             && (!changed.hasAny(['todayAttacks'])
               || (request.resource.data.todayAttacks is int
                 && request.resource.data.todayAttacks >= 0
                 && request.resource.data.todayAttacks <= 5))
             && (!changed.hasAny(['lastAttackDate'])
               || request.resource.data.lastAttackDate is string)
             && (!changed.hasAny(['bonusAttacksToday'])
               || (request.resource.data.bonusAttacksToday is int
                 && request.resource.data.bonusAttacksToday >= 0
                 && request.resource.data.bonusAttacksToday <= 1))
             && (!changed.hasAny(['lastBonusAttackDate'])
               || request.resource.data.lastBonusAttackDate is string)
             && (!changed.hasAny(['unlockedSkins'])
               || request.resource.data.unlockedSkins is list)
             && (!changed.hasAny(['shieldByLeague'])
               || request.resource.data.shieldByLeague is map);
        }

    // ── App configuration (maintenance mode, etc.) ─────────────────────────
    // Public read so the maintenance screen can be shown even before login.
    // No client writes — an administrator edits `config/app` in the Firebase
    // console.
    match /config/{docId} {
      allow read:  if true;
      allow write: if false;
    }

    // ── Users ──────────────────────────────────────────────────────────────
    // Profiles are currently read by league member and Arena screens. Writes
    // are schema-validated. Cross-user writes are limited strictly to HP data
    // needed by combat; economy and counters can never be changed by another
    // client.
    match /users/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
                    && request.auth.uid == userId
                    && validNewUser();
      allow delete: if signedIn() && request.auth.uid == userId;

      allow update: if signedIn() && validUserUpdate() && (
        request.auth.uid == userId
        ||
        request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['hpByLeague', 'lastHpResetByLeague'])
      );
    }

    // ── Leagues ────────────────────────────────────────────────────────────
    // Authenticated read is needed for the join-by-code query. Owners may edit
    // league settings. Other users may only add/remove themselves in memberIds.
    match /leagues/{leagueId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly([
                      'name', 'ownerId', 'memberIds', 'competitionType',
                      'createdAt', 'inviteCode'
                    ])
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.memberIds == [request.auth.uid]
                    && request.resource.data.name is string
                    && request.resource.data.inviteCode is string
                    && request.resource.data.competitionType in ['weekly', 'monthly'];

      allow update: if signedIn() && (
        // Owner can edit settings/membership, but cannot transfer ownership or
        // rewrite the original creation timestamp.
        (
          request.auth.uid == resource.data.ownerId
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.memberIds.hasAll([resource.data.ownerId])
        )
        ||
        // Join: add exactly the authenticated user and change nothing else.
        (
          !(request.auth.uid in resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size()
              == resource.data.memberIds.size() + 1
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberIds'])
        )
        ||
        // Leave: remove exactly the authenticated user and change nothing else.
        (
          request.auth.uid in resource.data.memberIds
          && request.auth.uid != resource.data.ownerId
          && !(request.auth.uid in request.resource.data.memberIds)
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && request.resource.data.memberIds.size()
              == resource.data.memberIds.size() - 1
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberIds'])
        )
      );
      allow delete: if signedIn()
                    && request.auth.uid == resource.data.ownerId;
    }

    // ── Tasks ──────────────────────────────────────────────────────────────
    // Only league members can read/write tasks.
    match /leagues/{leagueId}/tasks/{taskId} {
      allow read: if isLeagueMember(leagueId);
      allow create: if isLeagueMember(leagueId)
                    && request.resource.data.leagueId == leagueId
                    && (
                      request.resource.data.creatorId == request.auth.uid
                      ||
                      // A member may materialize one occurrence of an existing
                      // recurring template, but only assign that copy to self.
                      (
                        request.resource.data.assigneeId == request.auth.uid
                        && request.resource.data.parentTaskId is string
                        && request.resource.data.creatorId == get(
                          /databases/$(database)/documents/leagues/$(leagueId)/tasks/$(request.resource.data.parentTaskId)
                        ).data.creatorId
                      )
                    );
      allow update: if isLeagueMember(leagueId)
                    && request.resource.data.leagueId == leagueId
                    && request.resource.data.creatorId == resource.data.creatorId;
      allow delete: if isLeagueMember(leagueId);
    }

    // ── Task events (append-only history) ──────────────────────────────────
    match /leagues/{leagueId}/events/{eventId} {
      allow read: if isLeagueMember(leagueId);
      allow create: if isLeagueMember(leagueId)
                    && request.resource.data.keys().hasOnly([
                      'leagueId', 'taskId', 'taskTitle', 'doerId', 'targetId',
                      'damageDealt', 'coinsEarned', 'completedAt'
                    ])
                    && request.resource.data.leagueId == leagueId
                    && request.resource.data.doerId == request.auth.uid
                    && request.resource.data.taskId is string
                    && request.resource.data.taskTitle is string
                    && request.resource.data.damageDealt is int
                    && request.resource.data.damageDealt >= 0
                    && request.resource.data.damageDealt <= 1
                    && request.resource.data.coinsEarned is int
                    && request.resource.data.coinsEarned >= 0
                    && request.resource.data.coinsEarned <= 1
                    && request.resource.data.completedAt is timestamp
                    && (
                      request.resource.data.targetId == null
                      || request.resource.data.targetId in get(
                        /databases/$(database)/documents/leagues/$(leagueId)
                      ).data.memberIds
                    );
      allow update, delete: if false;
    }
  }
}
